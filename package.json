{
  "name": "@mp-consulting/homebridge-unifi-access",
  "version": "1.1.2",
  "displayName": "UniFi Access",
  "description": "Complete HomeKit support for UniFi Access devices — locks, doorbells, sensors, and readers — with automatic device discovery and realtime events.",
  "author": {
    "name": "MP Consulting",
    "url": "https://github.com/mp-consulting"
  },
  "homepage": "https://github.com/mp-consulting/homebridge-unifi-access#readme",
  "license": "(ISC AND MIT)",
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/mickaelpalma"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-unifi-access.git"
  },
  "bugs": {
    "url": "https://github.com/mp-consulting/homebridge-unifi-access/issues"
  },
  "type": "module",
  "engines": {
    "homebridge": ">=1.8.0 || >=2.0.0",
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homebridge-unifi-access",
    "homekit",
    "camera",
    "doorbell",
    "ubiquiti",
    "unifi",
    "unifi access",
    "unifi protect",
    "motion",
    "motion sensor",
    "security",
    "udm",
    "udm pro",
    "udm-pro",
    "unifi camera",
    "unifi cloud key",
    "unifi dream machine pro",
    "unifios"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "npm run copy:ui-assets && tsc",
    "clean": "shx rm -rf dist",
    "lint": "eslint . --max-warnings=0",
    "postpublish": "npm run clean",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "watch": "npm run build && npm link && nodemon",
    "start": "npm run build && homebridge -U ./test/hbConfig -D -I -P .",
    "monitor:events": "npx tsx scripts/event-schema-monitor.ts",
    "copy:ui-assets": "mkdir -p homebridge-ui/public/lib/fonts && cp node_modules/@mp-consulting/homebridge-ui-kit/dist/kit.css node_modules/@mp-consulting/homebridge-ui-kit/dist/kit.js homebridge-ui/public/lib/ && cp node_modules/bootstrap/dist/css/bootstrap.min.css node_modules/bootstrap/dist/js/bootstrap.bundle.min.js homebridge-ui/public/lib/ && cp node_modules/bootstrap-icons/font/bootstrap-icons.min.css homebridge-ui/public/lib/ && cp node_modules/bootstrap-icons/font/fonts/bootstrap-icons.woff node_modules/bootstrap-icons/font/fonts/bootstrap-icons.woff2 homebridge-ui/public/lib/fonts/"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mp-consulting/homebridge-ui-kit": "^1.0.0",
    "@types/node": "^25.9.4",
    "@vitest/coverage-v8": "^4.1.5",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "class-validator": "^0.15.1",
    "eslint": "^10.6.0",
    "homebridge": "^2.1.0",
    "homebridge-config-ui-x": "^5.24.0",
    "nodemon": "^3.1.14",
    "shx": "0.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@types/readable-stream": "4.0.23"
  }
}
